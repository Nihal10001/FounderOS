SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=

# Each agent group can use a different provider/model to spread load across
# separate quota pools. Defaults below split Research+Manager on Gemini,
# Finance+Marketing and Codegen on Groq (two different Groq models too).
RESEARCH_MANAGER_PROVIDER=gemini
RESEARCH_MANAGER_MODEL=gemini-3.5-flash
FINANCE_MARKETING_PROVIDER=groq
FINANCE_MARKETING_MODEL=llama-3.3-70b-versatile
CODEGEN_PROVIDER=groq
CODEGEN_MODEL=llama-3.1-8b-instant

CORS_ORIGINS=["http://localhost:3000"]